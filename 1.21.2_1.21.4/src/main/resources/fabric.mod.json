{
	"schemaVersion": 1,
	"id": "beegui",
	"version": "${version}",
	"name": "Bee GUI",
	"description": "A bee management GUI that lets you inspect the internal state of bee hives and nests.",
	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/bee-gui",
		"sources": "https://github.com/armaninyow/Bee-GUI",
		"issues": "https://github.com/armaninyow/Bee-GUI/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/beegui/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.armaninyow.beegui.BeeGUI"
		],
		"client": [
			"com.armaninyow.beegui.client.BeeGUIClient"
		]
	},
	"mixins": [
		"beegui.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=1.21.2 <1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	},
	"accessWidener": "beegui.accesswidener"
}
